{
  "name": "prompt-canvas-tool",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-tool.mjs",
    "dev:web": "vite",
    "dev:api": "node server/proxy.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "serve": "node server/proxy.mjs",
    "start:dev": "node scripts/dev-tool.mjs",
    "start:tool": "node scripts/prompt-tool.mjs start --install --build --open",
    "stop:tool": "node scripts/prompt-tool.mjs stop",
    "status:tool": "node scripts/prompt-tool.mjs status"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@xyflow/react": "^12.11.0",
    "concurrently": "^10.0.3",
    "cors": "^2.8.6",
    "dexie": "^4.4.3",
    "dexie-react-hooks": "^4.4.0",
    "express": "^5.2.1",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  }
}
